# =====================================================================
# ais-relay — configuration (SINGLE PLACE)
# =====================================================================
# Copy this file to /etc/ais-relay/ais-relay.conf and edit ONLY this file
# with the values for your installation. The systemd unit loads it
# automatically (EnvironmentFile).
#
#   sudo mkdir -p /etc/ais-relay
#   sudo cp deploy/ais-relay.conf.example /etc/ais-relay/ais-relay.conf
#   sudo nano /etc/ais-relay/ais-relay.conf
#   sudo systemctl restart ais-relay
#
# Format: KEY=value  (one per line). Lines starting with # are comments.

# ---------------------------------------------------------------------
# NMEA input (from your AIS decoder, e.g. AIS-catcher)
# ---------------------------------------------------------------------
AIS_RELAY_UDP_HOST=127.0.0.1
AIS_RELAY_UDP_PORT=10110
# 0 = loopback only (recommended). 1 = allow remote decoder (insecure).
AIS_RELAY_UDP_ALLOW_EXTERNAL=0

# ---------------------------------------------------------------------
# TCP output (to your clients)
# ---------------------------------------------------------------------
# "0.0.0.0" = LAN + VPN. For VPN ONLY, set the overlay IP (e.g. 10.0.0.5).
AIS_RELAY_TCP_HOST=0.0.0.0
AIS_RELAY_TCP_PORT=10110

# ---------------------------------------------------------------------
# Buffer and replay
# ---------------------------------------------------------------------
AIS_RELAY_RETENTION_SEC=3600
AIS_RELAY_MAX_ENTRIES=200000
AIS_RELAY_REPLAY_ON_CONNECT_SEC=30
AIS_RELAY_MAX_REPLAY_ENTRIES=20000

# ---------------------------------------------------------------------
# Protection (slow clients / connection abuse)
# ---------------------------------------------------------------------
AIS_RELAY_MAX_CLIENTS=64
AIS_RELAY_SEND_TIMEOUT_SEC=5

# ---------------------------------------------------------------------
# Token access (OPTIONAL). Empty = rely on the network ACL/firewall.
# If set, clients must send "AUTH <token>" as the first line.
# ---------------------------------------------------------------------
AIS_RELAY_TOKEN=

# ---------------------------------------------------------------------
# Disk persistence (OPTIONAL). Empty = no disk dump.
# ---------------------------------------------------------------------
AIS_RELAY_LOG_FILE=
AIS_RELAY_LOG_MAX_MB=64
AIS_RELAY_LOG_BACKUPS=2
